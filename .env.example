# Gemini API kaliti: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Asosiy model band bo'lsa ishlatiladigan zaxira model
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Instagram (Meta for Developers -> ilovangiz -> Instagram -> API setup with Instagram login)
IG_ACCESS_TOKEN=IGAA...
# Webhook sozlashda o'zingiz o'ylab topadigan maxfiy so'z
IG_VERIFY_TOKEN=ozim-oylab-topgan-soz
# Ilovaning "App secret"i (webhook imzosini tekshirish uchun, tavsiya etiladi)
IG_APP_SECRET=
GRAPH_VERSION=v23.0

# Ismingiz (agent "...ning AI yordamchisiman" deb tanishtiradi)
OWNER_NAME=

# Siz haqingizda javob bazada bo'lmasa aytiladigan gap (bo'sh qolsa standart matn)
FALLBACK_TEXT=
