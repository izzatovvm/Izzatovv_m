# Gemini API kaliti: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Asosiy model band bo'lsa ishlatiladigan zaxira model
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Instagram: Meta ilovasi -> Use cases -> Customize -> API setup with Unified login -> Generate token
IG_ACCESS_TOKEN=
GRAPH_VERSION=v26.0
# Direktni necha soniyada bir tekshirish
POLL_SECONDS=30
# Sinov uchun: faqat shu usernamelarga javob berish (vergul bilan). Bo'sh bo'lsa hammaga.
ONLY_USERNAMES=

# Faqat webhook (app.py) ishlatilsa kerak
IG_VERIFY_TOKEN=
IG_APP_SECRET=

# Ismingiz (agent "...ning AI yordamchisiman" deb tanishtiradi)
OWNER_NAME=

# Siz haqingizda javob bazada bo'lmasa aytiladigan gap (bo'sh qolsa standart matn)
FALLBACK_TEXT=
